---
interface Props {
	title: string;
	subtitle?: string;
}

const { title, subtitle } = Astro.props;
---

<section class="relative w-full pt-18 pb-24 dot-background">
	<div class="max-w-4xl mx-auto px-4 text-center">
		<slot name="pre-title" />
		<h1 class="text-4xl md:text-5xl font-bold mb-4">{title}</h1>
		{subtitle && <p class="text-lg text-[var(--text-muted)]">{subtitle}</p>}
		<slot />
	</div>
	<div class="absolute bottom-0 left-0 right-0 h-24 z-10 pointer-events-none" style="background: linear-gradient(to bottom, transparent, var(--bg-base));"></div>
</section>
