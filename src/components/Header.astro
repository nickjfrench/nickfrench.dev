---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Socials from './Socials.astro';
---

<header class="fixed top-0 left-0 right-0 z-50 m-0 px-4 bg-gradient-to-b from-black/90 to-transparent">
	<nav class="grid grid-cols-3 items-center">
		<h2 class="m-0 text-base justify-self-start">
			<a href="/" class="no-underline text-xl text-text font-handwritten tracking-wide">{SITE_TITLE}</a>
		</h2>
		<div class="internal-links flex justify-self-center">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/portfolio">Portfolio</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
		<div class="social-links flex max-md:hidden items-center justify-self-end gap-1">
			<Socials />
		</div>
	</nav>
</header>
