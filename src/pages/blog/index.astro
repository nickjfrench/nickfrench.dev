---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import PageHero from '../../components/PageHero.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';
import { codeToTitleCase } from "../../utils";

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Blog | ${SITE_TITLE}`} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<PageHero title="Blog" subtitle="Thoughts on development, AI, and building useful things." />
		<main>
			<div class="grid grid-cols-1 md:grid-cols-2 gap-8 pb-24">
				{
					posts.map((post) => (
						<a
							href={`/blog/${post.id}/`}
							class="group block rounded-xl overflow-hidden border border-border-base bg-bg-elevated hover:border-accent-base transition-all duration-300"
						>
							{post.data.heroImage && (
								<div class="aspect-video overflow-hidden">
									<Image
										width={720}
										height={360}
										src={post.data.heroImage}
										alt=""
										class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
									/>
								</div>
							)}
							<div class="p-6">
								<p class="text-sm text-text-muted mb-2">
									<FormattedDate date={post.data.pubDate} />
								</p>
								<h2 class="text-xl font-semibold mb-2 group-hover:text-accent-light transition-colors">
									{post.data.title}
								</h2>
								<p class="text-text-muted text-sm line-clamp-2">
									{post.data.description}
								</p>
								{post.data.tags && post.data.tags.length > 0 && (
									<div class="flex flex-wrap gap-2">
										{post.data.tags.slice(0, 4).map((tag) => (
											<span class="px-2 py-0.5 text-xs rounded bg-bg-base text-text-muted">
												{codeToTitleCase(tag)}
											</span>
										))}
										{post.data.tags.length > 4 && (
											<span class="px-2 py-0.5 text-xs rounded bg-bg-base text-text-muted">
												+{post.data.tags.length - 4}
											</span>
										)}
									</div>
								)}
							</div>
						</a>
					))
				}
			</div>
		</main>
		<Footer />
	</body>
</html>
