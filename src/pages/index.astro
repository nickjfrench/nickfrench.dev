---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroCard from '../components/HeroCard.astro';

import { SITE_DESCRIPTION, SITE_TITLE, NAME } from '../consts';

import headshotImg from '../assets/headshot.jpg';
import fullBodyImg from '../assets/full-body-portrait.webp';

const name = "Nick French"
const stack = "Nuxt, Vue, TS, Python, Golang"
const company = "Netrevenue"


---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<section class="relative w-full pt-8 pb-16 dot-background">
			<HeroCard name={NAME} tagline="A full-stack developer building LLM systems that are actually useful." imgSrc={headshotImg} />
			<div class="absolute bottom-0 left-0 right-0 h-24 z-10 pointer-events-none" style="background: linear-gradient(to bottom, transparent, var(--color-bg-base));"></div>
		</section>
		<main>
			<div class="pb-24" >
				<h1>Blog Posts</h1>
				<p>Find a list of my latest posts.</p>
			</div>
			<hr />
			<div class="py-24" >

			</div>
		</main>
		<Footer />
	</body>
</html>
