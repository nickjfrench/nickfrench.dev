---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import headshotImg from '../assets/headshot.jpg';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<div id="hero-section" class="w-full bg-black-light">
			<div class="max-w-4xl mx-auto px-4 py-12 flex flex-col items-center gap-7">
				<div id="hero-img" class="border border-slate-800 border-3 rounded-3xl w-40 shrink-0">
					<Image src={headshotImg} alt="My headshot portrait" class="rounded-3xl" />
				</div>
				<div id="hero-tagline" class="flex-2 flex flex-col items-start">
					<p class="text-base">Hey, I'm Nick,</p>
					<p class="text-xl">a full-stack dev, crafting LLM powered systems for the web.</p>
				</div>
			</div>
		</div>
		<main>
		</main>
		<Footer />
	</body>
</html>
