---
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import HeroFlow from '../components/flow/HeroFlow.vue';

import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

import headshotImg from '../assets/headshot.jpg';
import fullBodyImg from '../assets/full-body-portrait.webp';

const name = "Nick French"
const stack = "Nuxt, Vue, TS, Python, Golang"
const company = "Netrevenue"


---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<section class="relative w-screen dot-background overflow-hidden">
			<HeroFlow class="m-4" client:only="vue" />
		</section>
		<main>
		</main>
		<Footer />
	</body>
</html>
